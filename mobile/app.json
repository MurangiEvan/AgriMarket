{
  "expo": {
    "name": "AgriMarket",
    "slug": "agrimarket",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./public/agrimarket-icon-512.png",
    "scheme": "agrimarket",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./public/agrimarket-icon-512.png"
    },
    "android": {
      "package": "com.murangievan.agrimarket",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./public/agrimarket-icon-512.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./public/agrimarket-icon-192.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow AgriMarket to access photos you choose for your listings.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow AgriMarket to use your location to show produce near you."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#183f32",
          "image": "./public/agrimarket-icon-512.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "e14eecb8-fd33-4d10-9b28-ab2ec8581f1c"
      }
    },
    "owner": "murangievan"
  }
}
