{
  "name": "agrimarket-client",
  "version": "1.0.0",
  "description": "AgriMarket mobile app and progressive web app",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/ui": "~58.0.22",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.17",
    "expo-constants": "~58.0.13",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.9",
    "expo-glass-effect": "~58.0.4",
    "expo-image": "~58.0.16",
    "expo-linking": "~58.0.14",
    "expo-location": "~58.0.20",
    "expo-router": "~58.0.25",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "workbox-cli": "^7.4.1"
  },
  "scripts": {
    "dev": "expo start --web --port 9011",
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web --port 9011",
    "lint": "expo lint",
    "test": "tsx --test src/**/*.test.ts && node scripts/check-branding.mjs",
    "check:branding": "node scripts/check-branding.mjs",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export --platform web && workbox generateSW workbox-config.cjs"
  },
  "private": true
}
